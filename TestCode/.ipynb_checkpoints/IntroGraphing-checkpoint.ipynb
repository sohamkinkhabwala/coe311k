    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "x = np.linspace(0, 2*np.pi, 50)\n",
    "plt.plot(x, np.sin(x), \"r--\")\n",
    "plt.plot(x, np.cos(x), \"b-o\")\n",
    "#plt.plot(x, np.tan(x))\n",
    "plt.show()"
